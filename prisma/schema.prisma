generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  VOLUNTEER
}

enum UserAccessStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum UserAccountAuditAction {
  SUSPEND
  REACTIVATE
  ANONYMIZE
  NAME_CHANGE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeSlot {
  SLOT_07_09
  SLOT_09_11
  SLOT_11_13
  SLOT_13_15
  SLOT_15_17
}

enum AssignmentStatus {
  SCHEDULED
  PENDING_CONFIRMATION
  CONFIRMED
  DECLINED
  NEEDS_REPLACEMENT
  REASSIGNED
  COMPLETED
  CANCELLED
}

enum ResponseStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum AssignmentInvitationType {
  PRIMARY
  REPLACEMENT
}

enum AssignmentInvitationStatus {
  PENDING
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  FAILED
}

enum ReplacementCensusStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum ReplacementCensusResponseStatus {
  PENDING
  SENT
  SUBMITTED
  DECLINED
  EXPIRED
  FAILED
}

enum NotificationType {
  CONFIRMATION_REQUEST
  CENSUS_REQUEST
  CENSUS_REMINDER
  REMINDER
  REPLACEMENT_OPPORTUNITY
  FINAL_REMINDER
  RESET_PASSWORD
  ASSIGNMENT_UPDATE
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum AppNotificationType {
  CENSUS_PENDING
  ASSIGNMENT_PENDING
  ASSIGNMENT_CONFIRMED
  REPLACEMENT_NEEDED
  ADMIN_ATTENTION_REQUIRED
  EMAIL_FAILED
}

enum AppNotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AssignmentActivityType {
  ASSIGNED
  INVITATION_CREATED
  INVITATION_SENT
  INVITATION_FAILED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_EXPIRED
  REPLACEMENT_REQUIRED
  REPLACEMENT_SELECTED
  NO_REPLACEMENT_AVAILABLE
  ADMIN_ALERTED
  REMINDER_SENT
  RESPONSE_RECEIVED
  REPLACEMENT_ASSIGNED
  STATUS_OVERRIDDEN
  COMPLETED
  CANCELLED
  NOTES_UPDATED
}

model User {
  id                  String                @id @default(cuid())
  name                String
  email               String                @unique
  passwordHash        String
  role                UserRole
  phone               String
  active              Boolean               @default(true)
  accessStatus        UserAccessStatus      @default(APPROVED)
  accessReviewedAt    DateTime?
  accessReviewedById  String?
  accessReviewNote    String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  volunteerProfile    VolunteerProfile?
  accounts            Account[]
  sessions            Session[]
  notifications       NotificationLog[]
  appNotifications    AppNotification[]
  activities          AssignmentActivity[]
  createdWeeks        ScheduleWeek[]
  createdCensuses     ReplacementCensus[]
  passwordResets      PasswordResetToken[]
  accessReviewedBy    User?                 @relation("UserAccessReviews", fields: [accessReviewedById], references: [id], onDelete: SetNull)
  accessReviews       User[]                @relation("UserAccessReviews")
  accountAuditTargets UserAccountAuditLog[] @relation("UserAccountAuditTarget")
  accountAuditActors  UserAccountAuditLog[] @relation("UserAccountAuditActor")

  @@index([accessStatus, role, createdAt])
  @@index([accessReviewedById])
}

model UserAccountAuditLog {
  id           String                 @id @default(cuid())
  targetUserId String?
  actorUserId  String?
  action       UserAccountAuditAction
  note         String?
  metadata     Json?
  createdAt    DateTime               @default(now())
  targetUser   User?                  @relation("UserAccountAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  actorUser    User?                  @relation("UserAccountAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model VolunteerProfile {
  id                    String                          @id @default(cuid())
  userId                String                          @unique
  notes                 String?
  transportationNotes   String?
  preferredAreas        String[]
  reliabilityScore      Float                           @default(100)
  confirmationCount     Int                             @default(0)
  declineCount          Int                             @default(0)
  noResponseCount       Int                             @default(0)
  active                Boolean                         @default(true)
  temporaryUnavailable  Boolean                         @default(false)
  canServeAsPrimary     Boolean                         @default(true)
  canServeAsReplacement Boolean                         @default(false)
  user                  User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments           AssignmentVolunteer[]
  responses             AssignmentResponse[]
  invitations           AssignmentInvitation[]
  availability          VolunteerAvailability[]
  censusResponses       ReplacementCensusResponse[]
  weeklyAvailability    ReplacementWeeklyAvailability[]
  availabilityBlocks    AvailabilityException[]
}

model PreachingPoint {
  id          String                     @id @default(cuid())
  name        String
  area        String
  notes       String?
  active      Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  activeSlots PreachingPointActiveSlot[]
  assignments Assignment[]
}

model PreachingPointActiveSlot {
  id               String         @id @default(cuid())
  preachingPointId String
  dayOfWeek        DayOfWeek
  timeSlot         TimeSlot
  preachingPoint   PreachingPoint @relation(fields: [preachingPointId], references: [id], onDelete: Cascade)

  @@unique([preachingPointId, dayOfWeek, timeSlot])
}

model ScheduleWeek {
  id           String                          @id @default(cuid())
  startDate    DateTime
  endDate      DateTime
  label        String
  createdById  String
  createdAt    DateTime                        @default(now())
  createdBy    User                            @relation(fields: [createdById], references: [id])
  assignments  Assignment[]
  census       ReplacementCensus?
  availability ReplacementWeeklyAvailability[]

  @@unique([startDate, endDate])
}

model Assignment {
  id               String                 @id @default(cuid())
  scheduleWeekId   String
  date             DateTime
  dayOfWeek        DayOfWeek
  timeSlot         TimeSlot
  preachingPointId String
  pairNumber       Int                    @default(1)
  status           AssignmentStatus       @default(SCHEDULED)
  notes            String?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  scheduleWeek     ScheduleWeek           @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
  preachingPoint   PreachingPoint         @relation(fields: [preachingPointId], references: [id])
  volunteers       AssignmentVolunteer[]
  responses        AssignmentResponse[]
  invitations      AssignmentInvitation[]
  notifications    NotificationLog[]
  appNotifications AppNotification[]
  activities       AssignmentActivity[]

  @@unique([date, timeSlot, preachingPointId, pairNumber])
  @@index([date, timeSlot, status])
  @@index([date, timeSlot, preachingPointId])
  @@index([scheduleWeekId])
}

model AssignmentVolunteer {
  id            String           @id @default(cuid())
  assignmentId  String
  volunteerId   String
  slotNumber    Int
  isReplacement Boolean          @default(false)
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  volunteer     VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, slotNumber])
  @@unique([assignmentId, volunteerId])
  @@index([volunteerId])
}

model AssignmentResponse {
  id             String           @id @default(cuid())
  assignmentId   String
  volunteerId    String
  responseStatus ResponseStatus   @default(PENDING)
  note           String?
  respondedAt    DateTime?
  assignment     Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  volunteer      VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, volunteerId])
  @@index([volunteerId, responseStatus])
}

model AssignmentInvitation {
  id            String                     @id @default(cuid())
  assignmentId  String
  volunteerId   String
  type          AssignmentInvitationType
  status        AssignmentInvitationStatus @default(PENDING)
  token         String                     @unique
  sentAt        DateTime?
  respondedAt   DateTime?
  expiresAt     DateTime
  emailAttempts Int                        @default(0)
  metadata      Json?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  assignment    Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  volunteer     VolunteerProfile           @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([assignmentId, status])
  @@index([volunteerId, status])
  @@index([expiresAt, status])
  @@index([assignmentId, volunteerId, type, status])
}

model ReplacementCensus {
  id               String                      @id @default(cuid())
  scheduleWeekId   String                      @unique
  status           ReplacementCensusStatus     @default(DRAFT)
  sentAt           DateTime?
  closesAt         DateTime
  createdById      String
  metadata         Json?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  scheduleWeek     ScheduleWeek                @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
  createdBy        User                        @relation(fields: [createdById], references: [id])
  responses        ReplacementCensusResponse[]
  appNotifications AppNotification[]

  @@index([status, closesAt])
}

model ReplacementCensusResponse {
  id            String                          @id @default(cuid())
  censusId      String
  volunteerId   String
  status        ReplacementCensusResponseStatus @default(PENDING)
  token         String                          @unique
  sentAt        DateTime?
  respondedAt   DateTime?
  expiresAt     DateTime
  emailAttempts Int                             @default(0)
  metadata      Json?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt
  census        ReplacementCensus               @relation(fields: [censusId], references: [id], onDelete: Cascade)
  volunteer     VolunteerProfile                @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  availability  ReplacementWeeklyAvailability[]

  @@unique([censusId, volunteerId])
  @@index([volunteerId, status])
  @@index([expiresAt, status])
}

model ReplacementWeeklyAvailability {
  id               String                    @id @default(cuid())
  censusResponseId String
  volunteerId      String
  scheduleWeekId   String
  date             DateTime
  dayOfWeek        DayOfWeek
  timeSlot         TimeSlot?
  available        Boolean                   @default(true)
  notes            String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  censusResponse   ReplacementCensusResponse @relation(fields: [censusResponseId], references: [id], onDelete: Cascade)
  volunteer        VolunteerProfile          @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  scheduleWeek     ScheduleWeek              @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)

  @@unique([censusResponseId, date, timeSlot])
  @@index([scheduleWeekId, date, timeSlot, available])
  @@index([volunteerId, scheduleWeekId])
}

model VolunteerAvailability {
  id             String           @id @default(cuid())
  volunteerId    String
  dayOfWeek      DayOfWeek
  timeSlot       TimeSlot
  areaPreference String?
  available      Boolean          @default(true)
  recurring      Boolean          @default(true)
  volunteer      VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, dayOfWeek, timeSlot])
}

model AvailabilityException {
  id          String           @id @default(cuid())
  volunteerId String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  volunteer   VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId, startDate, endDate])
}

model NotificationLog {
  id            String              @id @default(cuid())
  userId        String
  assignmentId  String?
  type          NotificationType
  channel       NotificationChannel
  status        NotificationStatus
  sentAt        DateTime?
  errorMessage  String?
  metadata      Json?
  createdAt     DateTime            @default(now())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment    Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  webhookEvents EmailWebhookEvent[]

  @@index([userId, sentAt])
  @@index([assignmentId, userId, type, status])
}

model EmailWebhookEvent {
  id                String           @id @default(cuid())
  provider          String           @default("resend")
  providerEventId   String           @unique
  providerMessageId String?
  eventType         String
  notificationLogId String?
  metadata          Json?
  processedAt       DateTime         @default(now())
  createdAt         DateTime         @default(now())
  notificationLog   NotificationLog? @relation(fields: [notificationLogId], references: [id], onDelete: SetNull)

  @@index([providerMessageId, createdAt])
  @@index([notificationLogId, createdAt])
  @@index([eventType, createdAt])
}

model AppNotification {
  id           String                  @id @default(cuid())
  userId       String
  assignmentId String?
  censusId     String?
  type         AppNotificationType
  priority     AppNotificationPriority @default(NORMAL)
  title        String
  body         String
  readAt       DateTime?
  metadata     Json?
  createdAt    DateTime                @default(now())
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment   Assignment?             @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  census       ReplacementCensus?      @relation(fields: [censusId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([assignmentId, type])
  @@index([censusId, type])
}

model AssignmentActivity {
  id           String                 @id @default(cuid())
  assignmentId String
  actorUserId  String?
  actionType   AssignmentActivityType
  metadata     Json?
  createdAt    DateTime               @default(now())
  assignment   Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actorUser    User?                  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([assignmentId, createdAt])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AutomationAuditLog {
  id                String   @id @default(cuid())
  eventType         String
  eventCategory     String
  status            String?
  assignmentId      String?
  scheduleWeekId    String?
  censusId          String?
  censusResponseId  String?
  invitationId      String?
  notificationLogId String?
  appNotificationId String?
  actorUserId       String?
  automationRunId   String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([automationRunId, createdAt])
  @@index([assignmentId, createdAt])
  @@index([scheduleWeekId, createdAt])
  @@index([censusId, createdAt])
  @@index([censusResponseId, createdAt])
  @@index([invitationId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
