{
  "name": "ppam-scheduler",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "next dev",
    "dev:docker": "prisma generate && next dev --hostname 0.0.0.0",
    "build": "next build",
    "vercel:build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "db:start": "bash scripts/db-start.sh",
    "db:stop": "bash scripts/db-stop.sh",
    "db:status": "bash scripts/db-status.sh",
    "db:prepare": "npm run db:start && npm run db:push && npm run db:seed",
    "docker:dev": "docker compose up --build app",
    "docker:up": "docker compose up -d --build app",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:seed": "docker compose run --rm seed",
    "docker:reset": "docker compose down -v",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "prod:migrate": "prisma migrate deploy",
    "prod:create-admin": "tsx scripts/create-production-admin.ts",
    "qa:smoke": "tsx scripts/qa-production-smoke.ts",
    "qa:data:seed": "tsx scripts/qa-data.ts seed",
    "qa:data:cleanup": "tsx scripts/qa-data.ts cleanup",
    "e2e:data:seed": "tsx scripts/e2e-data.ts seed",
    "e2e:data:cleanup": "tsx scripts/e2e-data.ts cleanup",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:fake-users": "tsx scripts/seed-fake-volunteers.ts",
    "postinstall": "prisma generate",
    "ready:prod": "npm run lint && npm run test && npm run typecheck && npm run vercel:build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "nodemailer": "^8.0.11",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-query-devtools": "^5.59.20",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.19",
    "next-auth": "^4.24.11",
    "nodemailer": "^8.0.11",
    "react": "^19.0.0",
    "react-day-picker": "^9.4.4",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.2",
    "resend": "^6.12.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.10",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  }
}
