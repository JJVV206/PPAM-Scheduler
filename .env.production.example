# Vercel + Neon production environment
#
# Use the pooled Neon connection string for runtime queries.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"

# Use the direct Neon connection string for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Replace after Vercel creates the production deployment URL or custom domain.
NEXTAUTH_URL="https://your-vercel-project.vercel.app"

# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Recommended in production: Resend API.
# Replace re_xxxxxxxxx with your real Resend API key.
# For initial Resend free-plan testing you can use onboarding@resend.dev only
# for approved test recipients. For real volunteers, verify ppam.services in
# Resend and use a domain sender such as PPAM <no-reply@ppam.services>.
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM="PPAM <no-reply@ppam.services>"

# Optional SMTP fallback if Resend API is not configured.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
SMTP_FROM="PPAM Scheduler <no-reply@example.com>"
