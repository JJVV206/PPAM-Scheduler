DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ppam_scheduler?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ppam_scheduler?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Recommended production email provider: Resend API.
# Replace re_xxxxxxxxx with your real Resend API key.
RESEND_API_KEY=""
RESEND_FROM=""
RESEND_WEBHOOK_SECRET=""

# Local/dev SMTP fallback. Docker uses Mailpit internally.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PPAM Scheduler <no-reply@ppam.local>"
